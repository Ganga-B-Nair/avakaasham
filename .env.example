# Copy this file to .env and fill in your keys. Never put real keys in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI (Malayalam speech + chat): https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
# Leave blank for the model's default voice
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=saarika:v2.5

# Sarvam chat model for /api/analyze and /api/listen (sarvam-105b spends all tokens reasoning)
SARVAM_CHAT_MODEL=sarvam-105b-conversations
